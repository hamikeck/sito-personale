{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blog/**",
              "components/home/**",
              "components/site/**",
              "components/ui/**",
              "components/youtube/banner/**",
              "components/youtube/fullscreen/**",
              "components/youtube/overlay/**",
              "components/youtube/thumbnail/**",
              "ui_kits/sito/**",
              "ui_kits/youtube/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:nome|dettaglio|src|icona|accento|style|key|ref|className|style|children)$/]",
        "message": "<AppCard> doesn't accept that prop. Declared props: nome, dettaglio, src, icona, accento, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute[name.name='icona'] > Literal[value!=/^(?:github|linkedin|instagram|youtube)$/]",
        "message": "<AppCard> icona must be one of 'github' | 'linkedin' | 'instagram' | 'youtube'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|icona|size|locked|tone|rotate|children|style|key|ref|className|style|children)$/]",
        "message": "<AppTile> doesn't accept that prop. Declared props: src, icona, size, locked, tone, rotate, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTile'] > JSXAttribute[name.name='icona'] > Literal[value!=/^(?:github|linkedin|instagram|youtube)$/]",
        "message": "<AppTile> icona must be one of 'github' | 'linkedin' | 'instagram' | 'youtube'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<AppTile> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|titolo|data|minutiLettura|tag|descrizione|cover|href|onClick|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: slug, titolo, data, minutiLettura, tag, descrizione, cover, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|mono|as|onClick|pressed|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, size, mono, as, onClick, pressed, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|outline|ghost|destructive)$/]",
        "message": "<Badge> variant must be one of 'default' | 'secondary' | 'outline' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|label)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'label'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:span|a)$/]",
        "message": "<Badge> as must be one of 'span' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|brut|href|disabled|iconStart|iconEnd|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, brut, href, disabled, iconStart, iconEnd, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|outline|secondary|ghost|destructive|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive' | 'link'."
